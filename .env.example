LIVEKIT_URL=your_livekit_project_url_here
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here

# Optional — only needed for the isolated, disabled-by-default native LiveKit
# SIP telephony path (see telephony/setup_sip.py). Not required for the
# existing Twilio Media Streams -> LiveKit Connector flow.
# TWILIO_SIP_PHONE_NUMBER must be a SECOND, dedicated Twilio number, separate
# from whatever number is configured as the Connector's inbound webhook.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_SIP_PHONE_NUMBER=+1xxxxxxxxxx
